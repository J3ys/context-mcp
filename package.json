{
  "name": "contextmcp",
  "version": "1.0.0",
  "private": true,
  "description": "ContextMCP - Self-hosted MCP server for code and documentation in local projects",
  "workspaces": [
    "packages/cli",
    "packages/template"
  ],
  "scripts": {
    "dev:cli": "npm run dev --workspace=contextmcp",
    "build:cli": "npm run build --workspace=contextmcp",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reindex:example": "tsx packages/template/scripts/reindex.ts --config deployments/example/config.yaml",
    "reindex:example:dry": "tsx packages/template/scripts/reindex.ts --config deployments/example/config.yaml --dry-run",
    "deploy:example": "wrangler deploy --config deployments/example/cloudflare-worker/wrangler.jsonc",
    "dev:example": "wrangler dev --config deployments/example/cloudflare-worker/wrangler.jsonc"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "code-search",
    "semantic-search",
    "rag",
    "pinecone",
    "embeddings",
    "cloudflare-workers"
  ],
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.55.0"
  },
  "engines": {
    "node": ">=18"
  }
}
